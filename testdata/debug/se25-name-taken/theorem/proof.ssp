theorem T {
    instance S = S {
        params {
            n: 1,
        }
    }

    instance s2 = S {
        params {
            n: 1,
        }
    }

    gamehops {
        equivalence S s2 {
            invariant: [./theorem/invariant.smt2]
            O: {
                randomness: simple
                lemmas {
                    equal-aborts: []
                    invariant:    [no-abort]
                    same-output:  [no-abort]
                }
            }
        }
    }
}
