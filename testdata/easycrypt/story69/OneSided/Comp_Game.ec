(* Comp_Game.ec for theorem `OneSided`, composition `Game` — generated by `domino easycrypt`. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Pkg_Ctr.
require import Pkg_Ctr.

clone Pkg_Ctr as Cloned_Pkg_C.

module Pkg_Inst_C = Cloned_Pkg_C.Ctr.

module Game_Game : Interfaces.Iface_Game = {
  var abort_flag : bool

  proc init() : unit = {
    abort_flag <- false;
    Pkg_Inst_C.init();
  }

  proc d_Inc() : int option = {
    var ec_result : int option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_C.d_Inc();
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

module Exp_Game (A : Interfaces.Adv_Game) = {
  proc run() : bool = {
    var b' : bool;
    Game_Game.init();
    b' <@ A(Game_Game).run();
    return b';
  }
}.

type Game_side = {
  Game_pkg_C : Ctr_pkgstate;
  Game_abort_flag : bool
}.

op PkgInv_Game_C (s : Game_side) : bool =
  PkgInv_Ctr s.`Game_pkg_C.

op GameInv_Game (g : Game_side) : bool =
  0 <= g.`Game_pkg_C.`Ctr_ctr.

op side_inv_Game (s : Game_side) : bool =
     !s.`Game_abort_flag
  =>    PkgInv_Game_C s
     /\ GameInv_Game s.
