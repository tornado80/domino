(* generated by domino: invariant for L ~ R *)

require import AllCore Distr FMap Int IntDiv Types.
require import Pkg_Ctr.

type L_state = {
  l_pkg_C : Ctr_pkgstate;
  l_abort_flag : bool
}.

type R_state = {
  r_pkg_C : Ctr_pkgstate;
  r_abort_flag : bool
}.

op StateRelation_invariant (l : L_state) (r : R_state) : bool =
  l.`l_pkg_C.`Ctr_ctr = r.`r_pkg_C.`Ctr_ctr.

op params_inv (l : L_state) (r : R_state) : bool =
  true.

op inv (l : L_state) (r : R_state) : bool =
     params_inv l r
  /\ l.`l_abort_flag = r.`r_abort_flag
  /\ (   !l.`l_abort_flag
      => StateRelation_invariant l r).
