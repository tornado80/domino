theorem RedConsts {
    const b: Bool;

    instance key_real = KeyGame {
        params {
            ideal: false,
        }
    }

    instance key_ideal = KeyGame {
        params {
            ideal: true,
        }
    }

    instance mod_real = ModGame {
        params {
            ideal: false,
            flip: b,
        }
    }

    instance mod_ideal = ModGame {
        params {
            ideal: true,
            flip: b,
        }
    }

    instance mod_real_false = ModGame {
        params {
            ideal: false,
            flip: false,
        }
    }

    instance mod_ideal_false = ModGame {
        params {
            ideal: true,
            flip: false,
        }
    }

    instance mod_ideal_true = ModGame {
        params {
            ideal: true,
            flip: true,
        }
    }

    instance mod_real_true = ModGame {
        params {
            ideal: false,
            flip: true,
        }
    }

    assumptions {
        KeyAssumption: key_real ~ key_ideal
    }

    gamehops {
        reduction mod_real mod_ideal {
            assumption KeyAssumption

            map key_real mod_real {
                key: key
            }

            map key_ideal mod_ideal {
                key: key
            }
        }
        conjecture mod_ideal_false mod_ideal_true
    }

    propositions {
        FlipBound: mod_real_false ~ mod_real_true
        Free: mod_real ~ mod_ideal
    }
}
