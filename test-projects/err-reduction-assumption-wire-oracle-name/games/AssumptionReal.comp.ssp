composition AssumptionReal {
    const n: Integer;
    const m: Integer;
    const div: Integer;
    const enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m);

    instance key_1 = Key { params { n: n } }
    instance key_2 = Key { params { n: n } }
    instance Router = Router { params { n: n, div: div } }
    instance Enc = Enc { params { n: n, m: m, enc: enc } }

    compose {
        adversary: {
            Set_1: Set of key_1,
            Set_2: Set of key_2,
            Enc: Enc,
        },
        Enc: {
            cGET: Router,
        },
        Router: {
            /* The construction routes to Get, but this assumption game routes to
             * CGet. Get and CGet have the same signature, so only the oracle
             * name tells the wires apart. The reduction must be rejected. */
            Key_1_cGET: CGet of key_1,
            Key_2_cGET: CGet of key_2,
        },
    }
}
