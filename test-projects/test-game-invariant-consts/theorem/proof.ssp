theorem Proof {
    const u: Bool;
    const g: fn Integer -> Integer;

    instance C_0 = C {
        params {
            c: false,
            u: u,
            f: g,
        }
    }

    instance C_1 = C {
        params {
            c: true,
            u: u,
            f: g,
        }
    }

    instance D_1 = D {
        params {
            c: true,
            f: g,
        }
    }

    gamehops {
        equivalence C_1 D_1 {
            invariant: [
                ./theorem/invariant.smt2
            ]

            Inc: {
                randomness: none

                lemmas {
                    equal-aborts: []
                    same-output:  [no-abort]
                    invariant:    [no-abort]
                }
            }
            Get: {
                randomness: none

                lemmas {
                    equal-aborts: []
                    same-output:  [no-abort]
                    invariant:    [no-abort]
                }
            }
        }
    }
}
