composition C {
    const c: Bool;
    const f: fn Integer -> Integer;
    const u: Bool;

    invariant: [ ./games/C.smt2 ]

    instance P = P {
        params {
            b: c,
            f: f,
        }
    }

    compose {
        adversary: {
            Inc: P,
            Get: P,
        },
    }
}
