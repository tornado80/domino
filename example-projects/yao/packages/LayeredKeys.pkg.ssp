package LayeredKeys {
    params {
        n: Integer,
    }

    state {
        WireKey: Table(Integer, Table(Integer, Table(Bool, Bits(n)))),
        ActiveBit: Table(Integer, Table(Integer, Bool)),
    }


    oracle SetActiveBit(layer: Integer, wire: Integer, bit: Bool) {
        B <- new Table(Integer, Bool);
        if (ActiveBit[layer] != None) {
            B <- Unwrap(ActiveBit[layer]);
        }
        assert (B[wire] == None);
        B[wire] <- Some(bit);
        ActiveBit[layer] <- Some(B);
        return;
    }

    oracle GetActiveBit(layer: Integer, wire: Integer) -> Bool {
        B <- Unwrap(ActiveBit[layer]);
        b <- Unwrap(B[wire]);
        return b;
    }

    oracle GenerateWireKeys(layer: Integer, wire: Integer) {
        B <- Unwrap(ActiveBit[layer]);
        assert (B[wire] != None);
        K <- new Table(Integer, Table(Bool, Bits(n)));
        if (WireKey[layer] != None) {
            K <- Unwrap(WireKey[layer]);
        }
        if (K[wire] == None) {
            W <- new Table(Bool, Bits(n));
            k1 <- $Bits(n) sample-name key_true;
            W[true] <- Some(k1);
            k0 <- $Bits(n) sample-name key_false;
            W[false] <- Some(k0);
            K[wire] <- Some(W);
            WireKey[layer] <- Some(K);
        }
    }

    oracle GetWireKeys(layer: Integer, wire: Integer) -> Table(Bool, Bits(n)) {
        B <- Unwrap(ActiveBit[layer]);
        assert (B[wire] != None);
        K <- Unwrap(WireKey[layer]);
        W <- Unwrap(K[wire]);
        return W;
    }

    oracle GetActiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        K <- Unwrap(WireKey[layer]);
        W <- Unwrap(K[wire]);
        B <- Unwrap(ActiveBit[layer]);
        b <- Unwrap(B[wire]);
        k <- Unwrap(W[b]);
        return k;
    }

    oracle GetInactiveWireKey(layer: Integer, wire: Integer) -> Bits(n) {
        K <- Unwrap(WireKey[layer]);
        W <- Unwrap(K[wire]);
        B <- Unwrap(ActiveBit[layer]);
        b <- Unwrap(B[wire]);
        k <- Unwrap(W[not b]);
        return k;
    }
}
